# Ведущая косая черта значима: `dir/` в git — «каталог с этим именем на ЛЮБОЙ
# глубине», `/dir/` — «только в корне репозитория». Широкая форма пишется
# только там, где широта — решение.

# ── мусор ОС и редакторов ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.sw?
*~
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln

# ── состояние конкретного проекта, а не студии ───────────────────────────────
# `.studio/project.conf` и `.studio/zones.conf` — профиль проекта, версионируются
# как часть проекта. Приборные журналы внутри `.studio/` — нет: дописываются
# командой на каждый прогон, эталонов нет, к истории отношения не имеют.
/.studio/*.jsonl

# ── снимки приборов ──────────────────────────────────────────────────────────
# `snapshots/` — рабочий вывод health-check и usage-snapshot: пересоздаётся
# командой, эталонов нет, к истории отношения не имеет.
/snapshots/*
!/snapshots/.gitkeep

# ── локальное ────────────────────────────────────────────────────────────────
*.local
*.log
logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
/tmp/

# ── сборка (Tauri + React/TS) ────────────────────────────────────────────────
node_modules
dist
dist-ssr
/src-tauri/target/
/src-tauri/gen/

# ── личные материалы владельца продукта, не для распространения ─────────────
# Сторонние/защищённые авторским правом источники (DM's Guild и т.п.),
# используются только как личный референс при написании оригинального
# контента движка — не входят в приложение и не должны попасть в git.
/Генерация/
/*.pdf

# ── pid-файлы запущенного dev-сервера ─────────────────────────────────────────
# Пишутся при `npm run tauri dev`, живут ровно один прогон и остаются лежать
# после него (`tauri-dev.pid` пролежал неделю с мёртвым PID). Сам лог уже
# покрыт `*.log` выше.
*.pid

# ── исходники таблиц владельца ────────────────────────────────────────────────
# Переданы 16.09.2026 для карточки engine-event-generator. В git не идут по той же
# причине, что и SRD-PDF: источник, а не артефакт. Артефакт — структурированные
# данные, извлечённые из них. Происхождение файлов по ним самим не проверяется:
# ни копирайтов, ни имён авторов внутри нет.
/tables-source/
