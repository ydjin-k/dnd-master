{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Права окна мастера. Приложение и ЕСТЬ это окно: кампании, кубики, бой, справочники, запись картинки и вывод окна игроков — всё отсюда. Поэтому здесь перечислены ВСЕ свои команды, кроме ни одной: окно мастера ничего не потеряло от того, что права появились. Перечень обязан покрывать `invoke_handler` в `lib.rs` целиком — это сторожит `tests/commands_per_window.rs`.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "allow-load-active-campaign",
    "allow-list-campaigns",
    "allow-create-campaign",
    "allow-switch-campaign",
    "allow-delete-campaign",
    "allow-save-campaign",
    "allow-roll-dice",
    "allow-roll-ability-scores",
    "allow-get-bestiary",
    "allow-get-bestiary-image",
    "allow-get-rules",
    "allow-get-spells",
    "allow-get-character-presets",
    "allow-combat-add",
    "allow-combat-roll-initiative",
    "allow-combat-next-turn",
    "allow-combat-set-player-rules",
    "allow-combat-set-death-saves",
    "allow-apply-damage",
    "allow-combat-remove",
    "allow-combat-transfer-hp-to-sheets",
    "allow-end-combat",
    "allow-save-png-file",
    "allow-players-window-open",
    "allow-players-map-set",
    "allow-players-map-get"
  ]
}
